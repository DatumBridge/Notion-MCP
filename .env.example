# Notion MCP Client / tool-server façade

PORT=8000
LOG_LEVEL=INFO

# Hosted Notion MCP (do not change unless Notion publishes a new endpoint)
NOTION_MCP_URL=https://mcp.notion.com/mcp
NOTION_MCP_SSE_URL=https://mcp.notion.com/sse
NOTION_MCP_ORIGIN=https://mcp.notion.com

# OAuth local callback for scripts/oauth_connect.py (CLI default 8765).
# Leave unset for the HTTP Test UI so /oauth/start uses this server's /oauth/callback.
# OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
OAUTH_LISTEN_HOST=127.0.0.1
OAUTH_LISTEN_PORT=8765
NOTION_OAUTH_CLIENT_NAME=DatumBridge Notion MCP Client

# Path jail for credentials_path (defaults to project root)
# NOTION_CREDENTIALS_DIR=/var/notion-credentials

# Outbound HTTP timeout (seconds). Default 60.
NOTION_HTTP_TIMEOUT_SEC=60

# Refresh access tokens this many seconds before expires_in
NOTION_TOKEN_REFRESH_SKEW_SEC=300

# MCP protocol version advertised to Notion (server-selected version is honored)
NOTION_MCP_PROTOCOL_VERSION=2025-03-26

# Local file uploads must stay under this directory (defaults to NOTION_CREDENTIALS_DIR)
# NOTION_UPLOAD_DIR=/var/notion-uploads

# HTTP /oauth/start is loopback-only unless MCP_SERVICE_API_KEY or this flag is set
# NOTION_OAUTH_ALLOW_ANONYMOUS=1
# Write token.json from HTTP callback (off by default; CLI oauth_connect still writes)
# NOTION_OAUTH_PERSIST_TOKEN=1

# Optional Studio Integrations redirect after browser OAuth
# STUDIO_PUBLIC_URL=http://localhost:30080
# MCP_SERVICE_API_KEY=
